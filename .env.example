# Copy to .env and fill in. Every service refuses to start if a required variable is missing.
# Never commit .env. Keys that were ever committed to git history are considered leaked - rotate them.

# --- shared ---
MEDISCAN_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO

# --- postgres ---
POSTGRES_DB=mediscan
POSTGRES_USER=mediscan
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mediscan:change-me@localhost:5432/mediscan

# --- redis (celery broker + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- object storage (MinIO in dev, S3-compatible in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-change-me
S3_BUCKET_REPORTS=mediscan-reports
S3_BUCKET_BUNDLES=mediscan-bundles

# --- api (Django) ---
DJANGO_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-64
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_CLIENT_ID=

# --- service-to-service auth (api/worker -> inference, llm_gateway) ---
INTERNAL_SERVICE_TOKEN=generate-a-long-random-token
INFERENCE_URL=http://localhost:8001
LLM_GATEWAY_URL=http://localhost:8002

# --- llm gateway ---
LLM_PROVIDER=ollama                   # ollama | groq | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- payments ---
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2   # sandbox; prod: https://khalti.com/api/v2

# --- web (Vite) ---
VITE_API_URL=http://localhost:8000/api
VITE_KHALTI_PUBLIC_KEY=
